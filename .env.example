# AgentPay Mesh Configuration Template
# Copy this file to .env and fill in your credentials
#
# QUICK SETUP:
# 1. Get Circle API Key: https://developers.circle.com/
# 2. Create Entity Secret: Use Circle CLI or dashboard
# 3. Run: curl -X POST http://localhost:8000/setup/wallets
# 4. Update WALLET_ADDR_* and PRIVKEY_* fields below
# 5. Fund wallets: https://faucet.circle.com (select Arc Testnet)
#
# DEMO MODE:
# System will work in mock mode without any API keys configured
# Mock mode simulates payments and AI responses for demonstration
#
# ── Circle Credentials ─────────────────────────────
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET_CIPHERTEXT=your_encrypted_entity_secret_here

# ── Chain Config ────────────────────────────────────
CIRCLE_BLOCKCHAIN=ARC-TESTNET
CIRCLE_USDC_TOKEN_ID=USDC-ARC-TESTNET
ARC_CHAIN_ID=480
ARC_RPC_URL=https://rpc.arc-testnet.circle.com

# USDC Contract Address on Arc Testnet
# This is the USDC token contract address for verification purposes
# Source: Check Circle Developer Documentation or Arc blockchain explorer
# Fallback: System will work in mock mode if this is not configured
USDC_CONTRACT_ARC=0x_USDC_CONTRACT_ON_ARC_TESTNET

# ── Circle Nanopayments ─────────────────────────────
USE_NANOPAYMENTS=true
CIRCLE_NANOPAY_URL=https://api.circle.com/v1/w3s/nanopayments

# ── x402 Facilitator ────────────────────────────────
X402_FACILITATOR_URL=https://facilitator.chaoscha.in   # or Coinbase CDP

# ── Agent Wallet Addresses (set after /setup/wallets) ──
WALLET_ADDR_COORDINATOR=0x...
WALLET_ADDR_SEARCHAGENT=0x...
WALLET_ADDR_REVIEWAGENT=0x...
WALLET_ADDR_SUMMARYAGENT=0x...

# ── Agent Private Keys (Nanopayments signing) ───────
# WARNING: keep these secret, never commit to git
PRIVKEY_COORDINATOR=0x...
PRIVKEY_SEARCHAGENT=0x...
